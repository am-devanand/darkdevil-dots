{
  "model": "opencode/muse-spark-1.3-contributor-free",
  "plugin": ["oh-my-openagent@latest"],
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--browser", "chromium"],
      "enabled": true
    },
    "duckduckgo": {
      "type": "local",
      "command": ["/home/darkdevil/.local/bin/uvx", "--with", "duckduckgo-mcp-server[browser]", "duckduckgo-mcp-server"],
      "enabled": true
    },
    "freeweb": {
      "type": "local",
      "command": ["npx", "-y", "freeweb-mcp@latest"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["/home/darkdevil/.local/bin/uvx", "mcp-server-fetch"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/home/darkdevil"],
      "enabled": true
    }
  }
}
