{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#1a1b26cc",
    "bg_panel": "#16161ecc",
    "bg_element": "#292e42aa",
    "border": "#3b4261aa",
    "border_active": "#7aa2f7",
    "border_subtle": "#292e42aa",
    "fg": "#c0caf5",
    "fg_muted": "#a9b1d6",
    "primary": "#7aa2f7",
    "secondary": "#bb9af7",
    "accent": "#ff9e64",
    "red": "#f7768e",
    "yellow": "#e0af68",
    "green": "#9ece6a",
    "blue": "#7aa2f7",
    "teal": "#73daca",
    "comment": "#565f89"
  },
  "theme": {
    "primary": { "dark": "primary", "light": "primary" },
    "secondary": { "dark": "secondary", "light": "secondary" },
    "accent": { "dark": "accent", "light": "accent" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "yellow", "light": "yellow" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "blue", "light": "blue" },
    "text": { "dark": "fg", "light": "fg" },
    "textMuted": { "dark": "fg_muted", "light": "fg_muted" },
    "background": { "dark": "bg", "light": "bg" },
    "backgroundPanel": { "dark": "bg_panel", "light": "bg_panel" },
    "backgroundElement": { "dark": "bg_element", "light": "bg_element" },
    "border": { "dark": "border", "light": "border" },
    "borderActive": { "dark": "border_active", "light": "border_active" },
    "borderSubtle": { "dark": "border_subtle", "light": "border_subtle" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "fg_muted", "light": "fg_muted" },
    "diffHunkHeader": { "dark": "comment", "light": "comment" },
    "diffHighlightAdded": { "dark": "green", "light": "green" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "bg_element", "light": "bg_element" },
    "diffRemovedBg": { "dark": "bg_element", "light": "bg_element" },
    "diffContextBg": { "dark": "bg", "light": "bg" },
    "diffLineNumber": { "dark": "fg_muted", "light": "fg_muted" },
    "diffAddedLineNumberBg": { "dark": "bg_element", "light": "bg_element" },
    "diffRemovedLineNumberBg": { "dark": "bg_element", "light": "bg_element" },
    "markdownText": { "dark": "fg", "light": "fg" },
    "markdownHeading": { "dark": "primary", "light": "primary" },
    "markdownLink": { "dark": "blue", "light": "blue" },
    "markdownLinkText": { "dark": "teal", "light": "teal" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "comment", "light": "comment" },
    "markdownEmph": { "dark": "fg", "light": "fg" },
    "markdownStrong": { "dark": "fg", "light": "fg" },
    "markdownHorizontalRule": { "dark": "border_subtle", "light": "border_subtle" },
    "markdownListItem": { "dark": "teal", "light": "teal" },
    "markdownListEnumeration": { "dark": "accent", "light": "accent" },
    "markdownImage": { "dark": "blue", "light": "blue" },
    "markdownImageText": { "dark": "teal", "light": "teal" },
    "markdownCodeBlock": { "dark": "fg", "light": "fg" },
    "syntaxComment": { "dark": "comment", "light": "comment" },
    "syntaxKeyword": { "dark": "secondary", "light": "secondary" },
    "syntaxFunction": { "dark": "blue", "light": "blue" },
    "syntaxVariable": { "dark": "fg", "light": "fg" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "accent", "light": "accent" },
    "syntaxType": { "dark": "teal", "light": "teal" },
    "syntaxOperator": { "dark": "primary", "light": "primary" },
    "syntaxPunctuation": { "dark": "fg_muted", "light": "fg_muted" }
  }
}
